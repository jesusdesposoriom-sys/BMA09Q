#include <stdio.h>

int max_capturas(char arr[], int n, int K) {
    int colaP[n], colaT[n];
    int frenteP = 0, finalP = 0;
    int frenteT = 0, finalT = 0;
    int capturas = 0;
    int i;

    for (i = 0; i < n; i++) {
        if (arr[i] == 'P') {
            colaP[finalP++] = i;
        } else if (arr[i] == 'T') {
            colaT[finalT++] = i;
        }

        while (frenteP < finalP && frenteT < finalT) {
            int p = colaP[frenteP];
            int t = colaT[frenteT];

            if (p < t) {
                if (t - p <= K) {
                    capturas++;
                    frenteP++;
                    frenteT++;
                } else {
                    frenteP++;
                }
            } else {
                if (p - t <= K) {
                    capturas++;
                    frenteP++;
                    frenteT++;
                } else {
                    frenteT++;
                }
            }
        }
    }
    return capturas;
}

int main() {
    char caso1[] = {'P', 'T', 'T', 'P', 'T'};
    int K1 = 1;
    printf("Caso 1: %d capturas\n", max_capturas(caso1, 5, K1));

    char caso2[] = {'T', 'P', 'T', 'P'};
    int K2 = 2;
    printf("Caso 2: %d capturas\n", max_capturas(caso2, 4, K2));

    char caso3[] = {'P', 'T', 'P', 'T'};
    int K3 = 0;
    printf("Caso 3: %d capturas\n", max_capturas(caso3, 4, K3));

    return 0;
}


