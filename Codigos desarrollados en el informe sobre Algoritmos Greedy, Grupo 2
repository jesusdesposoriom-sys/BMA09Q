#include <stdio.h>
#include <stdlib.h>
#include <math.h>

// Funci�n comparadora para qsort (orden ascendente)
int comparar(const void *a, const void *b) {
    return (*(int*)a - *(int*)b);
}

int asignarRatones(int ratones[], int agujeros[], int n) {
    // 1. Ordenar ambos arreglos
    qsort(ratones, n, sizeof(int), comparar);
    qsort(agujeros, n, sizeof(int), comparar);

    int tiempoMaximo = 0;
    int i; 

    // 2. Emparejar uno a uno y encontrar la distancia m�xima
    for (i = 0; i < n; i++) { 
        int distancia = abs(ratones[i] - agujeros[i]);
        if (distancia > tiempoMaximo) {
            tiempoMaximo = distancia;
        }
    }

    return tiempoMaximo;
}

int main() {
    int ratones[] = {4, -4, 2};
    int agujeros[] = {4, 0, 5};
    int n = sizeof(ratones) / sizeof(ratones[0]);

    int minTiempo = asignarRatones(ratones, agujeros, n);
    printf("El tiempo minimo en el que todos los ratones estaran a salvo es: %d\n", minTiempo);

    return 0;
}


