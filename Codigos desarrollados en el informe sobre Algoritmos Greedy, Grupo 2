#include <stdio.h>

int main() {
    int monedas[] = {50, 20, 10, 5, 2, 1};
    int n = 6;
    int monto;
    int totalMonedas = 0;
    int i;

    printf("Ingrese el monto: ");
    scanf("%d", &monto);

    for (i = 0; i < n; i++) {

        int cantidad = monto / monedas[i];

        if (cantidad > 0) {
            printf("%d moneda(s) de %d\n", cantidad, monedas[i]);

            totalMonedas += cantidad;
            monto = monto % monedas[i];
        }
    }

    printf("Cantidad total de monedas: %d\n", totalMonedas);

    return 0;
}


