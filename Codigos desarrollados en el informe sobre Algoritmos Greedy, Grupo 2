#include <stdlib.h>

typedef struct {
    int id;
    int deadline;
    int profit;
} Job;

int comparar(const void *a, const void *b) {
    Job *j1 = (Job *)a;
    Job *j2 = (Job *)b;
    return j2->profit - j1->profit;
}

void jobSequencing(Job jobs[], int n) {
    qsort(jobs, n, sizeof(Job), comparar);

    int maxDeadline = 0;
    int i;
    
    for (i = 0; i < n; i++) {
        if (jobs[i].deadline > maxDeadline)
            maxDeadline = jobs[i].deadline;
    }

    int *slot = (int *)calloc(maxDeadline + 1, sizeof(int));
    int *resultado = (int *)malloc(n * sizeof(int)); 
    int totalProfit = 0;
    int count = 0;
    int t;

    for (i = 0; i < n; i++) {
        for (t = jobs[i].deadline; t >= 1; t--) {
            if (slot[t] == 0) {
                slot[t] = 1;
                resultado[count++] = i;
                totalProfit += jobs[i].profit;
                break;
            }
        }
    }

    printf("Trabajos seleccionados:\n");
    for (i = 0; i < count; i++) {
        int idx = resultado[i];
        printf("  J%d (deadline=%d, beneficio=%d)\n",
               jobs[idx].id, jobs[idx].deadline, jobs[idx].profit);
    }
    printf("Beneficio total = %d\n", totalProfit);

    free(slot);
    free(resultado);
}

int main() {
    Job caso1[] = {
        {1, 2, 100},
        {2, 1, 50},
        {3, 1, 30}
    };
    int n1 = sizeof(caso1) / sizeof(caso1[0]);
    printf("=== Caso 1 ===\n");
    jobSequencing(caso1, n1);
    printf("\n");

    Job caso2[] = {
        {1, 3, 40},
        {2, 1, 20},
        {3, 2, 60},
        {4, 2, 30}
    };
    int n2 = sizeof(caso2) / sizeof(caso2[0]);
    printf("=== Caso 2 ===\n");
    jobSequencing(caso2, n2);

    return 0;
}


