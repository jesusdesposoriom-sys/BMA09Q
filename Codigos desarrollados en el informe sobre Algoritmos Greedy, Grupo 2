#include <stdio.h>

#define V 5
#define INF 1000000

int main() {
    /* Matriz de adyacencia (0 = no hay arista) */
    int grafo[V][V] = {
        {0, 2, 0, 6, 0},
        {2, 0, 3, 8, 5},
        {0, 3, 0, 0, 7},
        {6, 8, 0, 0, 9},
        {0, 5, 7, 9, 0}
    };
    int costo[V];     /* menor costo conocido para conectar cada vertice */
    int padre[V];     /* de que vertice del arbol se conecta */
    int enArbol[V];   /* 1 si el vertice ya esta en el arbol */
    int i, k, u, v;
    int total = 0;

    for (i = 0; i < V; i++) {
        costo[i] = INF;
        enArbol[i] = 0;
    }
    costo[0] = 0;
    padre[0] = -1;

    for (k = 0; k < V; k++) {
        /* Eleccion greedy: vertice fuera del arbol con menor costo */
        u = -1;
        for (i = 0; i < V; i++)
            if (!enArbol[i] && (u == -1 || costo[i] < costo[u]))
                u = i;

        enArbol[u] = 1;
        total += costo[u];

        /* Actualizar costos de los vecinos de u */
        for (v = 0; v < V; v++)
            if (grafo[u][v] != 0 && !enArbol[v] && grafo[u][v] < costo[v]) {
                costo[v] = grafo[u][v];
                padre[v] = u;
            }
    }

    printf("Aristas del arbol de expansion minima:\n");
    for (i = 1; i < V; i++)
        printf("%d - %d  (costo %d)\n", padre[i], i, grafo[i][padre[i]]);
    printf("Costo total = %d\n", total);
    return 0;
}


