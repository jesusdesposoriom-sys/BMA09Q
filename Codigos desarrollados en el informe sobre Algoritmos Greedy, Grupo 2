#include<stdio.h>

typedef struct {
    char nombre;
    int inicio;
    int fin;
} Actividad;

int main() {

    Actividad actividades[] = {
        {'A', 1, 4},
        {'B', 3, 5},
        {'C', 0, 6},
        {'D', 5, 7},
        {'E', 3, 9},
        {'F', 5, 9},
        {'G', 6, 10},
        {'H', 8, 11},
        {'I', 8, 12},
        {'J', 2, 14},
        {'K', 12, 16}
    };

    int n = 11;

    // Las actividades ya están ordenadas por hora de finalización

    printf("Actividades seleccionadas:\n");

    // Seleccionamos la primera actividad
    printf("%c: %d - %d\n",
           actividades[0].nombre,
           actividades[0].inicio,
           actividades[0].fin);

    int ultimoFin = actividades[0].fin;
    int cantidad = 1;
    int i;

    // Recorremos las demás actividades
    for (i = 1; i < n; i++) {

        // Verificamos si la actividad es compatible
        if (actividades[i].inicio >= ultimoFin) {

            printf("%c: %d - %d\n",
                   actividades[i].nombre,
                   actividades[i].inicio,
                   actividades[i].fin);

            ultimoFin = actividades[i].fin;
            cantidad++;
        }
    }

    printf("\nTotal de actividades seleccionadas: %d\n", cantidad);

    return 0;
}


