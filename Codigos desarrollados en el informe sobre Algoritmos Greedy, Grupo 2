#include <stdio.h>

int main() {
    /* Arreglo basico ordenado de menor a mayor */
    int precios[] = {2, 3, 5, 8, 12};
    int n = 5;
    int presupuesto = 20;
    int cantidad = 0;
    int i;

    printf("Articulos comprados (precios): ");

    for (i = 0; i < n; i++) {
        /* Eleccion Greedy: el mas barato disponible, si alcanza */
        if (presupuesto >= precios[i]) {
            printf("%d ", precios[i]);
            presupuesto -= precios[i];
            cantidad++;
        } else {
            break;  /* los siguientes son mas caros, ya no alcanzan */
        }
    }

    printf("\nCantidad = %d, sobrante = %d\n", cantidad, presupuesto);
    return 0;
}


